# Copy to .env.local for local dev. In production set these in Cloudflare Pages -> Settings -> Environment variables.
# These are PUBLIC client values (protected by Firebase Auth + Firestore rules and key restrictions).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Maps Platform key (Geocoding API + Routes API), restricted by HTTP referrer.
# If blank, the app falls back to OpenStreetMap geocoding and a built-in route optimizer.
VITE_GOOGLE_MAPS_KEY=

# Server-side only (Cloudflare Pages Function secrets - NOT VITE_ and never committed):
#   EMAIL_API_KEY       Resend API key
#   EMAIL_FROM          e.g. "Glass Pickup <pickup@yourdomain.com>"
#   EMAIL_REPLY_TO      family contact address
#   FIREBASE_PROJECT_ID same as VITE_FIREBASE_PROJECT_ID
#   DAILY_SEND_CAP      optional, default 100
